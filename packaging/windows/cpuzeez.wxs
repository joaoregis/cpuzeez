<!-- WiX v5 per-machine installer: cpuzeez.exe in Program Files, Start menu
     shortcut, added to PATH, PawnIO modules next to the exe, and the optional
     "Hardware access" feature (ticked by default, can be unticked) that runs the bundled PawnIO
     installer. Inputs come from .github/scripts/fetch_pawnio.sh OUT:
     wix build cpuzeez.wxs -ext WixToolset.UI.wixext -arch x64 -d Version=x.y.z -d Bin=path\to\cpuzeez.exe
       -d IconFile=assets\cpuzeez.ico -d PawnIo=ABSOLUTE\PATH\TO\OUT (Files/@Include resolves a relative path against this file's folder)
     Silent installs include it; ADDLOCAL=Main leaves the driver out. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="CPU ZeeZ" Manufacturer="CPU ZeeZ contributors" Version="$(Version)"
           UpgradeCode="6F2C1A0E-4B7D-4E8A-9C35-2D1B7A9E0C41" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of CpuZeeZ is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/joaoregis/cpuzeez" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" />
    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CpuZeeZ">
        <Component Id="MainExe" Guid="*">
          <File Id="CpuzeezExe" Source="$(Bin)" KeyPath="yes" />
          <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
        <Component Id="ThirdParty" Guid="*">
          <File Id="ThirdPartyMd" Source="$(sys.SOURCEFILEDIR)..\..\THIRD_PARTY.md" KeyPath="yes" />
        </Component>
        <!-- Kept even without the feature: the app's "Install hardware access" button runs it. -->
        <Component Id="PawnIoSetup" Guid="*">
          <File Id="PawnIoSetupExe" Source="$(PawnIo)\PawnIO_setup.exe" KeyPath="yes" />
        </Component>
        <!-- ZeeZ Live frame timing (Intel PresentMon, MIT): the app checks its SHA-256 before running it. -->
        <Component Id="PresentMon" Guid="*">
          <File Id="PresentMonExe" Source="$(PawnIo)\PresentMon.exe" KeyPath="yes" />
        </Component>
        <Component Id="PresentMonLicense" Guid="*">
          <File Id="PresentMonLicenseTxt" Source="$(PawnIo)\PresentMon-LICENSE.txt" KeyPath="yes" />
        </Component>
        <Directory Id="ModulesFolder" Name="pawnio-modules" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <!-- No Icon attribute: the shortcut takes the icon embedded in cpuzeez.exe,
             whose path never changes. An Icon element lives in
             C:\Windows\Installer\{ProductCode}, which every upgrade deletes, and a
             taskbar pin (a copy of this shortcut) then shows a blank page. -->
        <Shortcut Id="AppShortcut" Name="CPU ZeeZ" Description="CPU, mainboard, memory and GPU information"
                  Target="[INSTALLFOLDER]cpuzeez.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\cpuzeez" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="CPU ZeeZ" Description="The app, its Start menu shortcut and the PawnIO modules." AllowAbsent="no">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="ThirdParty" />
      <ComponentRef Id="PawnIoSetup" />
      <ComponentRef Id="PresentMon" />
      <ComponentRef Id="PresentMonLicense" />
      <ComponentRef Id="StartMenuShortcut" />
      <Files Directory="ModulesFolder" Include="$(PawnIo)\pawnio-modules\*" />
    </Feature>

    <!-- Ticked by default (owner's decision, 2026-11-05) and explained in Custom Setup,
         where it can be unticked. -->
    <Feature Id="HardwareAccess" Level="1" Title="Hardware access (PawnIO driver)"
             Description="Installs the PawnIO driver by namazso (pawnio.eu) so CpuZeeZ can read CPU temperatures, voltages, memory SPD and timings. Shared with LibreHardwareMonitor and FanControl; uninstalling CpuZeeZ keeps it. Untick it to skip the driver; you can install it later from the app.">
      <Component Id="HardwareAccessChoice" Directory="INSTALLFOLDER" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\CpuZeeZ" Name="HardwareAccess" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Runs only when the feature is being installed now. A failure doesn't fail
         the install: the app explains what's missing and offers to retry. -->
    <CustomAction Id="InstallPawnIo" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]PawnIO_setup.exe&quot; -install -silent"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="InstallPawnIo" After="InstallFiles" Condition="(&amp;HardwareAccess = 3) AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
