# Repackages the prebuilt release binary (see .github/workflows/release.yml).
pkgname=cpuzeez-bin
pkgver=@VERSION@
# SemVer of the release tarball (differs from pkgver for pre-releases: 1.0.0-beta.2 vs 1.0.0beta2).
_srcver=@SRCVER@
pkgrel=1
pkgdesc="Clean-room, cross-platform reimplementation of CPU-Z's hardware information features"
arch=('x86_64')
url="https://github.com/joaoregis/cpuzeez"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
optdepends=('libxkbcommon: GUI keyboard input under Wayland/X11'
            'mesa: OpenGL for the GUI'
            'i2c-tools: SPD reading via i2c-dev (run as root)')
provides=('cpuzeez')
conflicts=('cpuzeez')
options=('!debug' '!strip')

package() {
  cd "$startdir/cpuzeez-$_srcver"
  install -Dm755 cpuzeez "$pkgdir/usr/bin/cpuzeez"
  install -Dm644 cpuzeez.desktop "$pkgdir/usr/share/applications/cpuzeez.desktop"
  install -Dm644 icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/cpuzeez.svg"
  for s in 32 48 64 128 256 512; do
    install -Dm644 "icon-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/cpuzeez.png"
  done
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
